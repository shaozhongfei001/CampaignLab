  "AC-001": [
   "AC-001",
   "启动本机模式，换取一次性会话，新建并进入工作区",
   "正常会话进入。重复令牌拒绝。工作区切换保留各自数据。worker 状态可见",
   "HTTP 与 Playwright"
  ],
  "AC-034": [
   "AC-034",
   "测试过期会话、错误 Host/Origin、跨工作区 ID 和上传失败",
   "按 401/403/404/413 或 422 返回。隔离、路径、日志和 ETag 证据可查",
   "HTTP 负例"
  ],
  "AC-035": [
   "AC-035",
   "按 M0 锁版本、迁移、核对包和 API",
   "`verify_package.py`、DDL 等价、OpenAPI 请求响应及前端生成类型通过。锁和运行环境清楚",
   "命令、锁和报告"
  ]
 }
