export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
cd /home/szf/dev/CampaignLab
O=/mnt/d/ws/codex_rd/ss_campaignlab/.orch_tmp/r18_s8gates.out
: > "$O"
run() { echo "===== $1 =====" | tee -a "$O"; shift; "$@" >> "$O" 2>&1; echo "rc=$?" | tee -a "$O"; }
run "V1 契约 sha16/bytes（逐字）" uv run --no-sync python -c "import hashlib,pathlib;d=pathlib.Path('contracts/openapi.json').read_bytes();print(hashlib.sha256(d).hexdigest()[:16],len(d))"
run "V2 -k state_machine（逐字）" uv run --no-sync pytest -q tests/integration/jobs -k state_machine
