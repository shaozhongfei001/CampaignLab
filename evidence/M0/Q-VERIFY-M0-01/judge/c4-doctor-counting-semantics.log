=== [1] doctor.sh 的 ok/warn/bad/info 定义与计数变量 ===
37:PASS=0; WARN=0; FAIL=0
38:ok()   { printf "  [ OK ] %s\n" "$1"; PASS=$((PASS+1)); }
39:warn() { printf "  [WARN] %s\n" "$1"; WARN=$((WARN+1)); }
40:bad()  { printf "  [FAIL] %s\n" "$1"; FAIL=$((FAIL+1)); }
41:info() { printf "         %s\n" "$1"; }
42:sec()  { printf "\n== %s ==\n" "$1"; }
