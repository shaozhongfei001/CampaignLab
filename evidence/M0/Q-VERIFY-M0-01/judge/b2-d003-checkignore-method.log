=== [2] 未跟踪的新 judge 日志：check-ignore -v 完整输出（看命中哪条规则）===
-- evidence/M0/Q-VERIFY-M0-01/judge/a1-python-gates-rerun.log --
.gitignore:18:!evidence/**/*.log	evidence/M0/Q-VERIFY-M0-01/judge/a1-python-gates-rerun.log
  rc_with_-v=0
  rc_without_-v=1 (0=被忽略并打印路径, 1=未被忽略)
.gitignore:18:!evidence/**/*.log	evidence/M0/Q-VERIFY-M0-01/judge/a1-python-gates-rerun.log
  rc_no_index_-v=0

