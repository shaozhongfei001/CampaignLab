{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseInput",
  "oneOf": [
    {
      "$ref": "#/$defs/CouponCaseInput"
    },
    {
      "$ref": "#/$defs/CallbackCaseInput"
    }
  ],
  "$defs": {
    "CouponEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "PAYMENT",
            "REFUND",
            "REDEEM"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "amount_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "other_offer_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "event_id",
        "kind",
        "at",
        "order_id",
        "amount_fen",
        "other_offer_applied"
      ],
      "additionalProperties": false
    },
    "CouponCaseInput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "template": {
          "const": "coupon_threshold"
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "initial_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "initial_budget_used_fen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CouponEvent"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "schema_version",
        "template",
        "customer_id",
        "registered_at",
        "initial_used",
        "initial_budget_used_fen",
        "events"
      ],
      "additionalProperties": false
    },
    "CallbackEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "appointment": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "event_id",
        "at",
        "strategy_id",
        "appointment"
      ],
      "additionalProperties": false
    },
    "CallbackCaseInput": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "template": {
          "const": "callback_priority"
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
        },
        "day": {
          "type": "string",
          "format": "date"
        },
        "channel": {
          "const": "remote"
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9000000000000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallbackEvent"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "schema_version",
        "template",
        "customer_id",
        "day",
        "channel",
        "used",
        "events"
      ],
      "additionalProperties": false
    }
  }
}
